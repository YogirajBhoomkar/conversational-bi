// The same HTTP contract as the Mastra routes (docs/CONTRACT.md), using the same core pieces: admission (limits and
// shutdown), trace ids, the request logger and the error rules. GC's own Okta guard identifies the user.
// Body size: set the app's JSON body limit to BI_MAX_BODY_BYTES (express.json({ limit })) in GC's main.ts.
import { Body, Controller, Get, HttpException, Inject, Post, Req, Res, UseGuards } from '@nestjs/common';
import type { Request, Response } from 'express';
// TODO(GC:nest-paths) point these at where the lifted code lives.
import type { BiConfig } from '../../../conversational-bi/src/config/load';
import { ChatRequestSchema, CONTRACT_VERSION, FeedbackRequestSchema } from '../../../conversational-bi/src/contracts';
import { type Admission, isRefusal, type Refusal } from '../../../conversational-bi/src/core/admission';
import { AuthError, UpstreamError, ValidationError } from '../../../conversational-bi/src/core/errors';
import { requestLogger } from '../../../conversational-bi/src/core/log';
import type { BiService } from '../../../conversational-bi/src/core/service';
import { traceIdOf } from '../../../conversational-bi/src/edge/traceId';
import type { BiRequestContext } from '../../../conversational-bi/src/ports/context';
import type { BiLogger } from '../../../conversational-bi/src/ports/logger';
// TODO(GC:okta-guard) GC's existing Okta guard, which validates the bearer token and puts the user on the request.
import { OktaAuthGuard } from '../auth/okta-auth.guard';

export const BI_SERVICE = Symbol('BI_SERVICE');
export const BI_ADMISSION = Symbol('BI_ADMISSION');
export const BI_CONFIG = Symbol('BI_CONFIG');
export const BI_LOGGER = Symbol('BI_LOGGER');

type OktaRequest = Request & { user?: { sub: string } }; // TODO(GC:okta-guard) GC's request user type

const invalid = (issues: { path: PropertyKey[]; message: string }[]) =>
  new HttpException({ error: 'Invalid request', issues: issues.map((i) => `${i.path.join('.') || 'body'}: ${i.message}`) }, 400);
const refused = (res: Response, r: Refusal) => res.status(r.status).set('Retry-After', String(r.retryAfterSeconds)).json({ error: r.message, reason: r.reason });

@Controller('bi') // TODO(GC:route-prefix) GC's global prefix applies in front of this
export class BiController {
  constructor(
    @Inject(BI_SERVICE) private readonly bi: BiService,
    @Inject(BI_ADMISSION) private readonly admission: Admission,
    @Inject(BI_CONFIG) private readonly config: BiConfig,
    @Inject(BI_LOGGER) private readonly logger: BiLogger,
  ) {}

  private context(req: OktaRequest, signal: AbortSignal): BiRequestContext {
    const bearer = /^Bearer\s+(.+)$/i.exec(req.headers.authorization ?? '')?.[1];
    if (!req.user?.sub || !bearer) throw new HttpException({ error: 'Please sign in again.', relogin: true }, 401);
    // The Okta token goes to GC's token service only; it is never logged or sent to Databricks.
    return { userId: req.user.sub, userToken: bearer, traceId: traceIdOf((n) => req.header(n)), signal };
  }

  @Post('chat')
  @UseGuards(OktaAuthGuard)
  async chat(@Req() req: OktaRequest, @Res() res: Response, @Body() body: unknown): Promise<void> {
    const parsed = ChatRequestSchema.safeParse(body);
    if (!parsed.success) throw invalid(parsed.error.issues);
    const abort = new AbortController();
    const ctx = this.context(req, abort.signal);
    const slot = this.admission.admit(ctx.userId);
    if (isRefusal(slot)) {
      requestLogger(this.logger, ctx).warn('chat.refused', { reason: slot.reason });
      refused(res, slot);
      return;
    }
    res.on('close', () => abort.abort()); // the browser left: stop the supervisor and Genie

    res.status(200).set({
      'Content-Type': 'text/event-stream',
      'Cache-Control': 'no-cache, no-transform',
      Connection: 'keep-alive',
      'X-Accel-Buffering': 'no',
      'X-Trace-Id': ctx.traceId,
    });
    res.flushHeaders();
    const { sseHeartbeatMs } = this.config.service;
    const heartbeat = sseHeartbeatMs > 0 ? setInterval(() => res.write(': keep-alive\n\n'), sseHeartbeatMs) : undefined;
    try {
      for await (const event of this.bi.handleChat(ctx, parsed.data)) {
        if (abort.signal.aborted) break;
        res.write(`data: ${JSON.stringify(event)}\n\n`);
      }
    } finally {
      clearInterval(heartbeat);
      slot.release();
      res.end();
    }
  }

  @Post('feedback')
  @UseGuards(OktaAuthGuard)
  async feedback(@Req() req: OktaRequest, @Body() body: unknown) {
    const parsed = FeedbackRequestSchema.safeParse(body);
    if (!parsed.success) throw invalid(parsed.error.issues);
    const ctx = this.context(req, new AbortController().signal);
    try {
      await this.bi.handleFeedback(ctx, parsed.data);
      return { ok: true };
    } catch (e) {
      if (e instanceof ValidationError) throw new HttpException({ error: e.message }, 400);
      if (e instanceof AuthError) throw new HttpException({ error: e.message, relogin: true }, 401);
      if (e instanceof UpstreamError) throw new HttpException({ error: 'Genie could not record the feedback.', traceId: ctx.traceId }, 502);
      requestLogger(this.logger, ctx).error('http.unexpected_error', { error: e });
      throw new HttpException({ error: 'Something went wrong. If it happens again, quote this reference.', traceId: ctx.traceId }, 500);
    }
  }

  @Get('version')
  version() {
    return { service: 'conversational-bi', contract: CONTRACT_VERSION, build: this.config.service.build };
  }
}
