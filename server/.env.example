# Copy this file to server/.env and fill in the values. Never commit server/.env.
#
# REQUIRED settings are listed without a "#". Fill every one of them.
# OPTIONAL settings start with "#". Leave them commented out to use the default.
# Do NOT leave an optional setting as "NAME=" with nothing after it: an empty value
# counts as "set", so it replaces the default (for example GENIE_ROW_CAP= becomes 0 rows).

# ---------------------------------------------------------------- Databricks (required)
# Workspace host, without https://   (for example <workspace>.azuredatabricks.net)
DATABRICKS_SERVER_HOSTNAME=
# Genie space ids. If left commented out, the ids built into server/src/genie/registry.ts are used.
# DATABRICKS_GENIE_SPACE_ID=
# DATABRICKS_GENIE_CAPACITY_SPACE_ID=

# ---------------------------------------------------------------- Login: pick ONE mode
# Mode A (local development): one shared personal access token. SECRET. Everyone acts as this token.
DATABRICKS_TOKEN=
# Mode B (per-user login, use this when sharing the app): the OAuth app connection's client id.
# When this is set, DATABRICKS_TOKEN is not used for users. No client secret is needed.
# DATABRICKS_CLIENT_ID=
# Optional: override the login callback address. Must match the redirect URL registered in Databricks.
# Default: http://localhost:<PORT>/auth/callback
# DATABRICKS_REDIRECT_URI=

# ---------------------------------------------------------------- AI model (required: option 1 OR option 2)
# Option 1: Anthropic (default). SECRET.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Option 2: an OpenAI-compatible endpoint (for example a proxy). Setting LLM_BASE_URL switches to this.
# LLM_BASE_URL=
# LLM_API_KEY=            # SECRET
# LLM_MODEL=gpt-5.1

# ---------------------------------------------------------------- Optional behaviour
# Use the newer Genie Agent mode (Beta). Only the value "agent" turns it on.
# GENIE_MODE=agent
# Rows kept per result (default 200), rows when loading the full result (default 5000), wait in ms (default 180000)
# GENIE_ROW_CAP=200
# GENIE_FULL_ROW_CAP=5000
# GENIE_TIMEOUT_MS=180000
# After the answer is sent, how long (ms) to wait for the app's own follow-up questions before closing the stream (default 8000)
# SUGGEST_WAIT_MS=8000
# Server port (default 4111 in dev; npm start uses 1976)
# PORT=1976

# ---------------------------------------------------------------- Not used by the current code
# Kept for reference only. You do not need to set these.
# DATABRICKS_HTTP_PATH=
# DATABRICKS_CATALOG=
# DATABRICKS_SCHEMA=
# DATABRICKS_PRODUCT_CATALOG=

# UI_DIST and API_URL are set by npm start and the UI dev server. Do not put them here.
