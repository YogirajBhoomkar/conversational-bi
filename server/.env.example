# Generated from server/src/config/schema.ts by "npm run env:example". Do not edit by hand.
# Copy this file to server/.env for local development and fill in the values. Never commit server/.env.
#
# REQUIRED settings are listed without a "#". Fill every one of them.
# OPTIONAL settings start with "#". Leave them commented out to use the default.
# An empty value (NAME=) counts as not set, so the default applies.
# The full list for a deployment, with who provides each value, is in docs/lift/GC-CONFIG.md.

# ---------------------------------------------------------------- Mode
# local: shared token or Databricks login, serves the UI (development). gc: Okta bearer token per request, no cookie login, no UI. One of: local, gc.
# BI_MODE=local
# Port the server listens on (npm start uses 1976).
# PORT=4111
# Path prefix of the chat and feedback routes (POST <prefix>/chat, POST <prefix>/feedback). Change it if the host API already uses /bi.
# BI_ROUTE_PREFIX=/bi

# ---------------------------------------------------------------- Databricks
# Workspace host, with or without https:// (for example <workspace>.azuredatabricks.net).
DATABRICKS_SERVER_HOSTNAME=
# local only: one shared personal access token. Everyone acts as this token. Not allowed in gc mode. SECRET.
DATABRICKS_TOKEN=
# local only: the OAuth app connection client id. When set, each user logs in to Databricks and DATABRICKS_TOKEN is not used.
# DATABRICKS_CLIENT_ID=
# local only: login callback address. Must match the redirect URL registered in Databricks. Default: http://localhost:<PORT>/auth/callback
# DATABRICKS_REDIRECT_URI=

# ---------------------------------------------------------------- Genie spaces
# JSON file listing the Genie spaces (see config/examples/spaces.example.json). Relative paths start from the server folder. Default in local mode: the example file.
# BI_SPACES_FILE=config/spaces.json
# The same list as BI_SPACES_FILE, inline as JSON. Wins over BI_SPACES_FILE.
# BI_SPACES_JSON=
# The Genie space id of each space, one line per space key: BI_SPACE_ID_<KEY> (the key in capitals). Wins over the spaceId in the
# spaces file, so one file can serve every environment. Needed for every space whose spaceId is REPLACE_ME (the example file).
# BI_SPACE_ID_<KEY>=
# Plain-text business rules appended to the supervisor prompt (see config/examples/domain-rules.example.md). Default in local mode: the example file.
# BI_DOMAIN_RULES_FILE=config/domain-rules.md

# ---------------------------------------------------------------- Scope
# Reply check for off-topic questions: when every Genie call of a turn answered with text only (no SQL, no rows) and no question went back to the user, the answer is not data. enforce: replace it with the scope message (no table, charts, sources or follow-ups). log: only record it. off: no check. No extra model calls. One of: off, log, enforce.
# BI_GUARD_SCOPE=enforce
# The reply to a question none of the Genie spaces can answer (a joke, general knowledge, coding). Default: built from the space names and descriptions ("I can help with questions about <spaces>. Ask me something about that data.").
# BI_SCOPE_MESSAGE=

# ---------------------------------------------------------------- Genie behaviour
# conversation: the Genie Conversation API. agent: Genie Agent mode (GA), which streams the agent's reasoning. Do not enable its Flash option (Beta). One of: conversation, agent.
# GENIE_MODE=conversation
# Rows kept per Genie result (the table preview).
# GENIE_ROW_CAP=200
# Rows kept when the user asks for the full result.
# GENIE_FULL_ROW_CAP=5000
# How long one Genie call may take, in milliseconds.
# GENIE_TIMEOUT_MS=180000
# How many times a Genie call is tried before giving up (with backoff between tries).
# GENIE_RETRY_ATTEMPTS=3
# Most questions this instance starts at Genie per minute (only the POST that starts a question counts, not polling). Set it to the workspace quota divided by the number of pods. 0 turns the limit off.
# BI_GENIE_MAX_PER_MINUTE=5
# Longest a question waits for a free Genie slot, in milliseconds; past it the data source answers that it is busy.
# BI_GENIE_QUEUE_WAIT_MS=60000
# How many of the latest earlier turns sent by the UI the server passes to the model, so follow-ups work. 0 turns history off.
# BI_HISTORY_TURNS=6
# Longest question and longest answer kept per earlier turn, in characters; longer text is cut and marked with an ellipsis.
# BI_HISTORY_MAX_CHARS=1500
# true: pass the SQL of earlier turns, when the UI sends it, to the model. false: any SQL sent is ignored.
# BI_HISTORY_INCLUDE_SQL=false
# After the answer, how long to wait for the app's own follow-up questions before closing the stream, in milliseconds.
# SUGGEST_WAIT_MS=8000

# ---------------------------------------------------------------- AI model
# Anthropic API key. Required unless LLM_BASE_URL is set. SECRET.
ANTHROPIC_API_KEY=
# Anthropic model id.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# An OpenAI-compatible endpoint (for example a model gateway). Setting it switches from Anthropic to this endpoint.
# LLM_BASE_URL=https://<gateway>/v1
# API key for LLM_BASE_URL. SECRET.
# LLM_API_KEY=
# Model name at LLM_BASE_URL.
# LLM_MODEL=gpt-5.1

# ---------------------------------------------------------------- Input guards
# Prompt-injection check on each question. off: none. log: record a hit and answer anyway. block: refuse the question. When on, it adds one call to BI_GUARD_MODEL per question, before anything streams. One of: off, log, block.
# BI_GUARD_INJECTION=off
# Model for the prompt-injection check (required unless BI_GUARD_INJECTION=off): a small, cheap model on the same provider and endpoint as the main model.
# BI_GUARD_MODEL=claude-haiku-5-5
# true: refuse the question when the guard model fails. false: answer anyway and log it. Honoured only on Mastra versions with errorStrategy; older ones always answer.
# BI_GUARD_FAIL_CLOSED=false

# ---------------------------------------------------------------- Service
# false switches chat and feedback off (503 with a friendly message) without taking the service down. Health checks keep answering.
# BI_ENABLED=true
# Largest request body accepted, in bytes (413 above it). Leave room for the chat history the UI sends with each question.
# BI_MAX_BODY_BYTES=65536
# Questions one user can have running at once (429 above it).
# BI_MAX_CONCURRENT_PER_USER=2
# Questions this instance runs at once, all users together (429 above it).
# BI_MAX_CONCURRENT_TOTAL=50
# Longest one question may run, in milliseconds; then it is stopped and the user is told.
# BI_TURN_TIMEOUT_MS=300000
# While an answer streams, a keep-alive comment is sent after this many milliseconds of silence, so proxies do not close the connection. 0 turns it off.
# BI_SSE_HEARTBEAT_MS=15000
# On SIGTERM, new questions are refused at once and running ones get this long to finish. Keep it below the pod's terminationGracePeriodSeconds.
# BI_SHUTDOWN_GRACE_MS=25000
# Comma-separated browser origins allowed to call the API from another origin. Default: http://localhost:5173 locally, none in gc mode (same origin only).
# BI_CORS_ORIGINS=https://<gc-ui-host>
# Space-separated origins allowed to show the served UI in a frame (Content-Security-Policy frame-ancestors). Default: 'self'.
# BI_FRAME_ANCESTORS='self' https://<gc-ui-host>
# The commit the image was built from; set by the image build (Dockerfile) and shown by GET <prefix>/version.
# BI_BUILD_SHA=local

# ---------------------------------------------------------------- Logging
# pretty: one readable line per event (default locally). json: one JSON object per line, for Datadog (default in gc mode). One of: pretty, json.
# BI_LOG_FORMAT=
# The lowest level written. One of: debug, info, warn, error.
# BI_LOG_LEVEL=info
# log: count the figures in each answer that match nothing the data returned (grounding in the chat.turn log; the values only with BI_LOG_CONTENT). Never changes the answer. off: no check. One of: off, log.
# BI_GROUNDING=log
# true: also log question and answer text and SQL (for debugging only). Secrets are removed either way.
# BI_LOG_CONTENT=false

# ---------------------------------------------------------------- Output guards
# on: remove images, links, raw HTML, bare URLs and internal agent or tool names from what the model writes, and replace an answer with figures when no data came back. No extra model calls. One of: on, off.
# BI_GUARD_OUTPUT=on

# ---------------------------------------------------------------- Local UI
# local only: folder of the built UI to serve from the same port. npm start sets it; do not put it in .env.
# UI_DIST=
