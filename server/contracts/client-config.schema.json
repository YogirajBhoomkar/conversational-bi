{
  "title": "ClientConfig",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "feedback": {
      "type": "object",
      "properties": {
        "to": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Where feedback emails go; null hides the Send feedback button"
        },
        "content": {
          "type": "string",
          "enum": [
            "full",
            "question",
            "ids"
          ],
          "description": "How much chat text goes into the email"
        },
        "maxUrlChars": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Budget for the whole mailto link, after URL encoding"
        }
      },
      "required": [
        "to",
        "content",
        "maxUrlChars"
      ]
    },
    "userRef": {
      "type": "string",
      "description": "The caller's short one-way hash, as in the logs; never the user id itself"
    },
    "build": {
      "type": "string"
    },
    "contract": {
      "type": "string"
    }
  },
  "required": [
    "feedback",
    "userRef",
    "build",
    "contract"
  ],
  "$comment": "Conversational BI contract 1.4.0. Generated by npm run contracts; do not edit."
}
